# 공용 Supabase PostgreSQL (pooler) — 카페 운영 데이터(cafe_sales/cafe_menu_sales/cafe_reviews)
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-1-us-west-1.pooler.supabase.com:6543/postgres

# Google Gemini 무료 API 키 (https://aistudio.google.com/apikey 에서 무료 발급)
GEMINI_API_KEY=여기에_키_붙여넣기

# 로컬 서버 포트 (기본 3000)
PORT=3000
