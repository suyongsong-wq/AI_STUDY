# ImageKit 키 — https://imagekit.io → Developer options → API Keys
# 아래 3개를 채우고 파일명을 .env 로 저장하세요. (.env는 git에 커밋되지 않습니다)

IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/여기_본인_ID
IMAGEKIT_PUBLIC_KEY=public_여기_퍼블릭키
IMAGEKIT_PRIVATE_KEY=private_여기_프라이빗키

# 토스페이먼츠 테스트 키 — https://developers.tosspayments.com → 내 개발정보 → 테스트
TOSS_CLIENT_KEY=test_ck_여기_클라이언트키
TOSS_SECRET_KEY=test_sk_여기_시크릿키

# 선택: 서버 포트 (기본 8777)
# PORT=8777
